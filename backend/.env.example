# App Configuration
APP_NAME=Quant Platform
ENVIRONMENT=development
DEBUG=true

# Supabase (Direct PostgreSQL / REST)
SUPABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_KEY=

# LLM – Primary: Featherless AI (gpt-oss-120b)
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=your-featherless-api-key
LLM_MODEL=gpt-oss-120b

# LLM – Fallback: NVIDIA NIM (supports rotation across comma-separated keys)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3
NVIDIA_NIM_MODEL=gpt-oss-120b

# IBM Quantum Hardware
IBM_QUANTUM_TOKEN=your-ibm-quantum-token
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# Market Data Providers
FRED_API_KEY=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
COINGECKO_API_KEY=CG-your-demo-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Security
SECRET_KEY=change-me-in-production-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Risk Parameters
RISK_FREE_RATE=0.05
TRADING_DAYS_PER_YEAR=252
